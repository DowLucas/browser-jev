# Copy to /opt/stacks/jev-runner/.env (chmod 600). Never commit the real file.
RUNNER_TOKEN=generate-with-openssl-rand-hex-32
TYPESAFE_API_KEY=
# Optional push notification when a run finishes
NTFY_URL=
# Domains the runner must never target: your own infrastructure (comma-separated)
RUNNER_BLOCKED_SUFFIXES=.internal.example,.ts.net
# Host directory for jobs, reports, traces and saved login sessions
RUNNER_DATA_DIR=./data
